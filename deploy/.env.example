# 唯一环境模板：复制为 deploy/.env 后在本地填写；真实 .env 不入库。
# 这里没有真实凭据。密码和 JWT_SECRET 必须另行生成并填写，不能留空上线。
# 06.1 只建立模板，不代表配置加载、服务或判题器已经实现。

# 开发依赖服务（06.3 使用）；API 在 WSL 本地运行。
MYSQL_DATABASE=oj
MYSQL_USER=oj_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=

# URL 中的 REPLACE_ME 是占位符，分别替换为上面的 MySQL / Redis 密码。
# URL 密码部分须进行百分号编码；此处不要直接粘贴包含 @、:、/ 等字符的原始密码。
# 本地 API 通过 127.0.0.1 访问依赖；mysql/redis 服务名留给后续容器部署。
# 后续开发 Compose 只向本机地址发布依赖端口；本节尚未创建 Compose。
DATABASE_URL=mysql+asyncmy://oj_app:REPLACE_ME@127.0.0.1:3306/oj
DATABASE_URL_SYNC=mysql+pymysql://oj_app:REPLACE_ME@127.0.0.1:3306/oj
REDIS_URL=redis://:REPLACE_ME@127.0.0.1:6379/1
CELERY_BROKER_URL=redis://:REPLACE_ME@127.0.0.1:6379/0

# 安全：JWT 算法由设计固定为 HS256，密钥仅从真实环境配置读取。
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# 判题：保留设计 14.2 的初始建议，本节不启用或创建以下目录/镜像。
# 具体租约和重试边界留待 W5；C++ 为可后置项。
# JUDGE_WORK_DIR 的权限与 bind mount 由 06.5 另行验收，不在此处申请 root。
JUDGE_IMAGE_PYTHON=oj-judge-python:1
JUDGE_IMAGE_CPP=oj-judge-cpp:1
JUDGE_WORK_DIR=/var/oj/judge-work
JUDGE_LEASE_SECONDS=60
JUDGE_MAX_ATTEMPTS=3

# 运行
LOG_LEVEL=INFO
